#!/usr/bin/env bash
# Install these dotfiles. Run: ./install --help for help and examples.
#
# This is the orchestrator. The data (packages, languages, symlinks) and
# shared helpers live in _install/. First-run scaffolding lives in ./bootstrap.

set -o errexit

# -----------------------------------------------------------------------------
# Path resolution + shared library
# -----------------------------------------------------------------------------

if [ -z "${DOTFILES_PATH:-}" ]; then
  DOTFILES_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"

# shellcheck disable=SC1091
source "${DOTFILES_PATH}/_install/env"

# -----------------------------------------------------------------------------
# Install-specific helpers
# -----------------------------------------------------------------------------

_local_clone() {
  [ -z "${LOCAL:-}" ] && return 1

  if [ "${PWD}" != "${DOTFILES_PATH}" ]; then
    cp -R "${PWD}/." "${DOTFILES_PATH}"
  fi

  printf "They've been locally copied to '%s'\n" "${DOTFILES_PATH}"
}

_no_system_packages() {
  cat <<EOF
System package installation isn't supported with your distro (${OS_DISTRO})

Please install any comparable packages on your own, you can view the list at:

    https://github.com/${DOTFILES_REPO_SLUG:-lucasvienna/dotfiles}/blob/main/_install/packages/

Then re-run this script and explicitly skip installing system packages:

    ./install --skip-system-packages
EOF

  exit 1
}

_install_packages_debian() {
  APT_PACKAGES="$(echo "${APT_PACKAGES}" | xargs)"

  if [[ -n "${APT_PACKAGES}" || -n "${APT_PACKAGES_EXTRAS}" ]]; then
    sudo apt-get update && sudo apt-get install -y ${APT_PACKAGES} ${APT_PACKAGES_EXTRAS}
  fi

  # Mise itself.
  sudo install -dm 755 /etc/apt/keyrings
  curl -fsSL https://mise.jdx.dev/gpg-key.pub | gpg --dearmor | sudo tee /etc/apt/keyrings/mise-archive-keyring.gpg 1>/dev/null
  echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=amd64] https://mise.jdx.dev/deb stable main" | sudo tee /etc/apt/sources.list.d/mise.list
  sudo apt-get update && sudo apt-get install -y mise

  # Apt versions tend to lag, so we prefer Mise for these tools.
  MISE_PACKAGES_DEBIAN="$(echo "${MISE_PACKAGES_DEBIAN}" | xargs)"
  echo
  if [[ -n "${MISE_PACKAGES_DEBIAN}" || -n "${MISE_PACKAGES_DEBIAN_EXTRAS}" ]]; then
    mise use --global ${MISE_PACKAGES_DEBIAN} ${MISE_PACKAGES_DEBIAN_EXTRAS}
  fi

  # fastfetch — Debian 13 / Ubuntu 26.04 LTS will have it in apt by default.
  echo
  curl -fsSL https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-amd64.deb -o /tmp/fastfetch.deb
  sudo dpkg -i /tmp/fastfetch.deb
  rm /tmp/fastfetch.deb

  # git-delta — Debian 13 will have it in apt by default, Ubuntu 24.04+ LTS has it.
  echo
  curl -fsSL https://github.com/dandavison/delta/releases/download/0.18.2/git-delta_0.18.2_amd64.deb -o /tmp/git-delta.deb
  sudo dpkg -i /tmp/git-delta.deb
  rm /tmp/git-delta.deb

  # Sublime Merge / Text — never on apt.
  echo
  curl -fsSL https://download.sublimetext.com/sublimehq-pub.gpg | sudo tee /etc/apt/keyrings/sublimehq-pub.asc >/dev/null
  echo -e 'Types: deb\nURIs: https://download.sublimetext.com/\nSuites: apt/stable/\nSigned-By: /etc/apt/keyrings/sublimehq-pub.asc' | sudo tee /etc/apt/sources.list.d/sublime-text.sources
  sudo apt-get update && sudo apt-get install -y sublime-merge sublime-text
}

_install_packages_arch() {
  PACMAN_PACKAGES="$(echo "${PACMAN_PACKAGES}" | xargs)"
  AUR_PACKAGES="$(echo "${AUR_PACKAGES}" | xargs)"

  if [[ -n "${PACMAN_PACKAGES}" || -n "${PACMAN_PACKAGES_EXTRAS}" ]]; then
    sudo pacman -Syu --needed --noconfirm ${PACMAN_PACKAGES} ${PACMAN_PACKAGES_EXTRAS}
  fi

  if [[ -n "${AUR_PACKAGES}" || -n "${AUR_PACKAGES_EXTRAS}" ]]; then
    echo
    detect_aur_helper || return 1
    echo "Using '${AUR_HELPER}' for AUR packages"
    # shellcheck disable=SC2086
    _aur_install ${AUR_PACKAGES} ${AUR_PACKAGES_EXTRAS}
  fi

  # Populate pkgfile's database so command-not-found suggestions work, and keep
  # it fresh. Purely a convenience, so never fail the install over it.
  echo
  sudo pkgfile --update || _warning "pkgfile database sync failed"
  sudo systemctl enable --now pkgfile-update.timer ||
    _warning "Could not enable pkgfile-update.timer"
}

_install_packages_macos() {
  local prefix="/opt/homebrew"
  [[ "${CPU_ARCH}" == "x86_64" ]] && prefix="/usr/local"

  eval "$(${prefix}/bin/brew shellenv)"

  BREW_PACKAGES="$(echo "${BREW_PACKAGES}" | xargs)"
  BREW_CASK_PACKAGES="$(echo "${BREW_CASK_PACKAGES}" | xargs)"

  if [[ -n "${BREW_PACKAGES}" || -n "${BREW_PACKAGES_EXTRAS}" ]]; then
    brew install ${BREW_PACKAGES} ${BREW_PACKAGES_EXTRAS}
  fi

  if [[ -n "${BREW_CASK_PACKAGES}" || -n "${BREW_CASK_PACKAGES_EXTRAS}" ]]; then
    brew install --cask --adopt ${BREW_CASK_PACKAGES} ${BREW_CASK_PACKAGES_EXTRAS}
  fi

  MISE_PACKAGES_MACOS="$(echo "${MISE_PACKAGES_MACOS}" | xargs)"
  echo
  if [[ -n "${MISE_PACKAGES_MACOS}" || -n "${MISE_PACKAGES_MACOS_EXTRAS}" ]]; then
    mise use --global ${MISE_PACKAGES_MACOS} ${MISE_PACKAGES_MACOS_EXTRAS}
  fi
}

_display_packages_output() {
  local packages="${1:-}"
  local packages_extras="${2:-}"
  local secondary="${3:-}"
  local secondary_extras="${4:-}"
  # Debian and macOS pull extra tools from Mise; Arch pulls them from the AUR.
  local secondary_label="${5:-Mise}"

  [ -n "${packages}" ] && printf "\n:: Packages (default)\n%s" "${packages}"
  [ -n "${packages_extras}" ] && printf "\n:: Packages (extras)\n%s" "${packages_extras}"
  [ -n "${secondary}" ] && printf "\n:: %s (default)\n%s" "${secondary_label}" "${secondary}"
  [ -n "${secondary_extras}" ] && printf "\n:: %s (extras)\n%s" "${secondary_label}" "${secondary_extras}"

  # The tests above are the last statements, so an empty extras list would
  # otherwise make this function return 1.
  return 0
}

_display_packages() {
  case "${OS_DISTRO}" in
  debian)
    _display_packages_output \
      "${APT_PACKAGES}" "${APT_PACKAGES_EXTRAS}" \
      "${MISE_PACKAGES_DEBIAN}" "${MISE_PACKAGES_DEBIAN_EXTRAS}"
    ;;
  arch)
    _display_packages_output \
      "${PACMAN_PACKAGES}" "${PACMAN_PACKAGES_EXTRAS}" \
      "${AUR_PACKAGES}" "${AUR_PACKAGES_EXTRAS}" "AUR"
    ;;
  darwin)
    [ -n "${BREW_CASK_PACKAGES}" ] && BREW_PACKAGES+="${BREW_CASK_PACKAGES}"
    [ -n "${BREW_CASK_PACKAGES_EXTRAS}" ] && BREW_PACKAGES_EXTRAS+="${BREW_CASK_PACKAGES_EXTRAS}"

    _display_packages_output \
      "${BREW_PACKAGES}" "${BREW_PACKAGES_EXTRAS}" \
      "${MISE_PACKAGES_MACOS}" "${MISE_PACKAGES_MACOS_EXTRAS}"
    ;;
  esac
}

# stow refuses to replace a real file, and it's normal for a config we ship to
# already exist — CachyOS ships an alacritty.toml, a distro may ship a .zshrc.
# Move those aside so stow has a clear path. Backups are never overwritten, and
# nothing is deleted, so this needs no prompt.
#
# Note this walks the whole package rather than asking stow what it would
# conflict on, so a file stow would have ignored can also get backed up. That
# only ever leaves a spare .bak behind.
_backup_stow_conflicts() {
  local dir="${1}"
  local target="${2}"
  local package="${3}"
  local source_root="${dir}/${package}"
  local relative dest backup resolved n
  local source_real=

  [ -d "${source_root}" ] || return 0

  source_real="$(cd "${source_root}" && pwd -P)" || return 0

  while IFS= read -r -d '' relative; do
    relative="${relative#"${source_root}/"}"
    dest="${target}/${relative}"

    # Only real files block stow; its own symlinks are replaced happily.
    [[ -e "${dest}" && ! -L "${dest}" ]] || continue

    # stow folds trees: it links a whole directory when it can, so
    # ~/.config/nvim/lua is a symlink into the package. Files beneath it are
    # not symlinks themselves, yet they resolve back into the repo -- moving
    # one would rename the repo's own file rather than back anything up.
    resolved="$(readlink -f "${dest}" 2>/dev/null || true)"

    if [ -n "${resolved}" ]; then
      case "${resolved}" in
      "${source_real}/"*) continue ;;
      esac
    fi

    backup="${dest}.bak"
    n=1
    while [ -e "${backup}" ]; do
      backup="${dest}.bak.${n}"
      n=$((n + 1))
    done

    mv "${dest}" "${backup}"
    printf "  kept your existing %s as %s\n" "${relative}" "$(basename "${backup}")"
  done < <(find "${source_root}" -type f -print0)
}

# Make sure a git-ignored override file lives in the repo, so it's editable
# centrally and stow can symlink it into place like everything else.
#
# Earlier versions wrote some of these straight into ${HOME}, which left them
# as real files outside the repo -- and stow then refused to replace them. Any
# such file is moved in rather than overwritten, so its contents survive.
_ensure_local_file() {
  local repo_path="${1}"
  local home_path="${2}"
  local default_content="${3}"

  if [[ ! -e "${repo_path}" && -f "${home_path}" && ! -L "${home_path}" ]]; then
    mv "${home_path}" "${repo_path}"
    printf "  moved %s into the repo so it can be edited centrally\n" "${home_path/${HOME}/\~}"
    return 0
  fi

  [ -e "${repo_path}" ] && return 0

  printf "%s" "${default_content}" >"${repo_path}"
}

_stowit() {
  local package="${*: -1}"
  # An array, not a string: word-splitting a quoted string passed the literal
  # single quotes through to stow, so the ignore regex never matched and
  # theme.* files (absolute symlinks made by set_theme) broke every stow that
  # couldn't fold its tree.
  local stow_flags=(--restow "--ignore=(theme\.(sh|theme|ron|conf|lua|toml)|theme|claude)")
  local stow_output
  local stow_exit=0
  local stow_args=("${@}")
  local stow_dir=
  local stow_target=
  local i

  for ((i = 0; i < ${#stow_args[@]}; i++)); do
    case "${stow_args[i]}" in
    -d) stow_dir="${stow_args[i + 1]}" ;;
    -t) stow_target="${stow_args[i + 1]}" ;;
    esac
  done

  # stow errors out if --target doesn't exist. Create it here rather than
  # relying on create_initial_dirs listing every target, which silently drifts
  # out of sync whenever a package is added to _install/symlinks.
  [ -n "${stow_target}" ] && mkdir -p "${stow_target}"

  if [[ -n "${stow_dir}" && -n "${stow_target}" ]]; then
    _backup_stow_conflicts "${stow_dir}" "${stow_target}" "${package}"
  fi

  if [ -n "${DEBUG:-}" ]; then
    stow_flags+=(--verbose)
    stow_output=$(stow "${stow_flags[@]}" "$@" 2>&1) || stow_exit=$?
    echo "$stow_output" | grep -v "BUG in find_stowed_path" || true
  else
    stow_output=$(stow "${stow_flags[@]}" "$@" 2>&1) || stow_exit=$?
  fi

  if [ ${stow_exit} -ne 0 ]; then
    echo "✗ Failed to symlink ${package}" >&2
    return ${stow_exit}
  fi

  echo "✓ Symlinked ${package}"
  [ -n "${DEBUG:-}" ] && echo

  return 0
}

# -----------------------------------------------------------------------------
# Phase functions
# -----------------------------------------------------------------------------

check_prereqs() {
  _info "CHECKING SYSTEM COMPATIBILITY"

  local missing_packages=()

  command -v sudo >/dev/null 2>&1 || missing_packages+=("sudo")

  if [ ${#missing_packages[@]} -eq 0 ]; then
    echo "Everything is good to go"
    return 0
  fi

  cat <<EOF
This script is going to switch to the root user to install sudo. The rest of
the script will run as your user and use sudo as needed.

EOF

  case "${OS_DISTRO}" in
  debian)
    su -c "apt-get update && apt-get install -y ${missing_packages[*]}"
    ;;
  arch)
    su -c "pacman -Syu --needed --noconfirm ${missing_packages[*]}"
    ;;
  esac
}

create_initial_dirs() {
  mkdir -p \
    "${HOME}/.cache/zsh" \
    "${HOME}/.config/alacritty" \
    "${HOME}/.config/bottom" \
    "${HOME}/.config/btop/themes" \
    "${HOME}/.config/fzf" \
    "${HOME}/.config/gh" \
    "${HOME}/.config/ghostty" \
    "${HOME}/.config/git" \
    "${HOME}/.config/gitui" \
    "${HOME}/.config/nvim" \
    "${HOME}/.config/starship" \
    "${HOME}/.config/tmux/plugins" \
    "${HOME}/.config/zsh" \
    "${HOME}/.local/bin" \
    "${HOME}/.local/share/fonts" \
    "${XDG_DATA_HOME:-${HOME}/.local/share}/zsh/custom/plugins" \
    "${GHQ_ROOT:-${HOME}/Workspace}"

  # alacritty.toml imports this unconditionally, so it has to exist even on a
  # fresh clone. Lives in the repo (git-ignored) and is stowed like everything
  # else, so per-machine font and title stay centrally editable.
  _ensure_local_file \
    "${DOTFILES_PATH}/.config/alacritty/local.toml" \
    "${HOME}/.config/alacritty/local.toml" \
    "# Machine-specific alacritty overrides (not tracked by git).
"
}

install_packages() {
  _info "INSTALL PACKAGES"

  if [ -n "${SKIP_SYSTEM_PACKAGES}" ]; then
    _skipping "--skip-system-packages was passed"
    return
  fi

  [ -z "${YYES}" ] && cat <<EOF
If you choose y, all of the system packages below will be installed:

$(_display_packages)


If you choose no, the above packages will not be installed and this script
will exit. This gives you a chance to edit the list of packages.

EOF
  [ -n "${YYES}" ] && cat <<EOF
The following system packages will be installed:

$(_display_packages)

EOF
  printf "You can edit '_install/packages/${OS_DISTRO}' or 'install-config' to modify the list.\n\n"

  while true; do
    [ -z "${YYES}" ] && read -rp "Do you want to install the above packages? (y/n) " yn
    [ -n "${YYES}" ] && yn=y
    case "${yn}" in
    [Yy]*)
      case "${OS_DISTRO}" in
      debian) _install_packages_debian ;;
      arch) _install_packages_arch ;;
      darwin) _install_packages_macos ;;
      esac
      break
      ;;
    [Nn]*) exit ;;
    *) printf "Please answer y or n\n\n" ;;
    esac
  done
}

update_dotfiles() {
  _info "UPDATE DOTFILES"

  if [ -z "${DOTFILES_PATH:-}" ]; then
    _skipping "First time you've run this script"
    return 0
  fi

  if [[ -z "${PULL}" && -z "${PULL_UPDATE}" ]]; then
    _skipping "Rerun with --pull or --update to get the latest changes"
    return 0
  fi

  if [ -n "${LOCAL}" ]; then
    _skipping "LOCAL=1 is set, avoiding remote updates"
    return 0
  fi

  git -C "${DOTFILES_PATH}" fetch origin

  local new_commit_count=
  new_commit_count="$(git -C "${DOTFILES_PATH}" rev-list HEAD..@{u} --count 2>/dev/null || echo "0")"

  if [ "${new_commit_count}" = "0" ]; then
    _skipping "Your local dotfiles already have the latest updates"
  else
    git -C "${DOTFILES_PATH}" merge origin

    cp -n "${DOTFILES_PATH}/install-config.example" "${DOTFILES_PATH}/install-config"

    # If new config was introduced upstream we need to re-source everything.
    exec "${0}" "${@}"
  fi
}

clone_dotfiles() {
  _info "CLONE DOTFILES"

  if [ -d "${DOTFILES_PATH:-}" ]; then
    _skipping "DOTFILES_PATH already exists at '${DOTFILES_PATH}'"
    return 0
  fi

  local default_dotfiles_path="${HOME}/dotfiles"

  read -rep "Where do you want to clone these dotfiles to [${default_dotfiles_path}]? " dotfiles_path
  echo

  [ -z "${dotfiles_path}" ] && dotfiles_path="${default_dotfiles_path}"

  DOTFILES_PATH="${dotfiles_path//\~/${HOME}}"

  _local_clone && return 0

  git clone "${DOTFILES_CLONE_URL}" "${DOTFILES_PATH}"
  git -C "${DOTFILES_PATH}" remote | grep -qw upstream ||
    git -C "${DOTFILES_PATH}" remote add upstream "${DOTFILES_UPSTREAM_URL}.git"

  cp -n "${DOTFILES_PATH}/install-config.example" "${DOTFILES_PATH}/install-config"
}

install_fonts() {
  _info "INSTALL FONTS"

  local font_url="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/CascadiaCode.zip"
  local font_tmp="/tmp/cascadiacode"
  local font_zip="/tmp/cascadiacode.zip"
  local font_filename="CaskaydiaCoveNerdFont-Regular.ttf"
  local windows_font_path="/mnt/c/Windows/Fonts"
  local macos_font_path="${HOME}/Library/Fonts"
  local linux_font_path="${XDG_DATA_HOME:-"${HOME}/.local/share"}/fonts"
  local font_path=

  if [ "${OS_TYPE}" = "linux" ]; then
    font_path="${linux_font_path}"
    [ "${OS_IN_WSL}" = "1" ] && font_path="${windows_font_path}"
  else
    font_path="${macos_font_path}"
  fi

  # Arch ships ttf-cascadia-code-nerd, which is in PACMAN_PACKAGES, so there's
  # nothing to download. Still refresh the cache: manually installed fonts
  # (MonoLisa and friends) dropped into the font path get picked up here.
  if [ "${OS_DISTRO}" = "arch" ]; then
    _skipping "Nerd Font comes from ttf-cascadia-code-nerd on Arch"
    fc-cache -f
    return
  fi

  if [ -f "${font_path}/${font_filename}" ]; then
    _skipping "Fonts are already installed at '${font_path}'"
    return
  fi

  rm -rf "${font_zip}" "${font_tmp}"
  curl -sSL "${font_url}" -o "${font_zip}"
  unzip "${font_zip}" -d "${font_tmp}"

  if [ "${OS_IN_WSL}" = "1" ]; then
    rm "${font_tmp}/LICENSE" "${font_tmp}/README.md"
    cat <<EOF

Since we're in WSL 2 and we need to install Windows fonts, please do it manually.

Most of it has been automated for you, from within WSL 2 perform these steps:

1. cd ${font_tmp}
2. explorer.exe .
3. Right click the fonts and INSTALL FOR ALL USERS
4. rm -rf "${font_zip}" "${font_tmp}"

It's important step 3 is for all users not your personal user. It's also
important step 4 is executed so this script doesn't always download the font's
zip file and extract it to step 1.
EOF
    return 0
  fi

  cp "${font_tmp}"/CaskaydiaCoveNerdFont*.ttf "${font_path}"

  [ "${OS_TYPE}" = "linux" ] && fc-cache -fv

  rm -rf "${font_zip}" "${font_tmp}"
}

install_omz() {
  _info "INSTALL OH-MY-ZSH"

  local install_tmp="/tmp/omz_install.sh"
  local system_omz="/usr/share/oh-my-zsh"
  export omz_path="${HOME}/.oh-my-zsh"

  # Custom plugins always live under XDG_DATA_HOME, never inside $ZSH — a
  # packaged $ZSH is root-owned, and this keeps plugins out of harm's way even
  # when OMZ is reinstalled. Must match what .zshrc exports.
  export ZSH_CUSTOM="${XDG_DATA_HOME:-${HOME}/.local/share}/zsh/custom"

  # Distros that package Oh-My-Zsh win — CachyOS ships oh-my-zsh-git at
  # /usr/share/oh-my-zsh, which pacman keeps updated. No second copy needed.
  if [ -d "${system_omz}" ]; then
    _skipping "Using the system Oh-My-Zsh at '${system_omz}'"
    export ZSH="${system_omz}"
    return 0
  fi

  # Pin ZSH rather than inheriting it. CachyOS exports ZSH at its own copy from
  # cachyos-config.zsh, and the OMZ installer aborts when $ZSH is an existing
  # directory — so an inherited value would break the fallback path too.
  export ZSH="${omz_path}"

  if [ -f "${omz_path}/tools/upgrade.sh" ]; then
    echo "Already installed, updating"
    sh -c "${omz_path}/tools/upgrade.sh"
  else
    curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh -o "${install_tmp}"

    ZDOTDIR="${ZDOTDIR:-${XDG_CONFIG_HOME}/zsh}"
    chmod +x "${install_tmp}"
    sh -c "${install_tmp}" "" --unattended --keep-zshrc
  fi
}

install_omz_plugins() {
  _info "INSTALL OH-MY-ZSH PLUGINS"

  "${DOTFILES_PATH}/.local/bin/update-omz-plugins"
}

create_symlinks() {
  _info "STOWING APP PACKAGES"

  local symlinks=()
  local symlinks_wsl=()

  [ -n "${SYMLINKS[*]}" ] && symlinks+=("${SYMLINKS[@]}")
  [ -n "${SYMLINKS_EXTRAS[*]:-}" ] && symlinks+=("${SYMLINKS_EXTRAS[@]}")

  [ -n "${SYMLINKS_WSL[*]}" ] && symlinks_wsl+=("${SYMLINKS_WSL[@]}")
  [ -n "${SYMLINKS_WSL_EXTRAS[*]:-}" ] && symlinks_wsl+=("${SYMLINKS_WSL_EXTRAS[@]}")

  printf -- "-------------------------------------------------------------------------------\n"

  if [ ${#symlinks[@]} -gt 0 ]; then
    printf "\nSymlinks:\n"
    for link in "${symlinks[@]}"; do
      echo "  ${link}"
    done
  fi

  local windows_user=
  if [[ "${OS_IN_WSL}" = "1" && ${#symlinks_wsl[@]} -gt 0 ]]; then
    windows_user="$(powershell.exe '$env:UserName' 2>/dev/null | tr -d '\r\n')"

    printf "\nSymlinks (WSL):\n"
    for link in "${symlinks_wsl[@]}"; do
      echo "  ${link//%WindowsUser/${windows_user}}"
    done
  fi

  [ -z "${YYES}" ] && cat <<EOF

-------------------------------------------------------------------------------

A potentially destructive action is about to happen. The above directories and
files are going to get forcefully symlinked if you type y in the prompt below.

What does that mean?

Any config files you have on the right hand side of the paths are going to get
overwritten with the files that come with these dotfiles (left side).

Without these symlinks, these dotfiles will not work as is. If you plan to
type y and have existing files now would be a good time to back them up.

EOF

  while true; do
    [ -z "${YYES}" ] && read -rep "Ready to continue? Enter y to apply them all or n to skip (y/n) " yn
    [ -n "${YYES}" ] && yn=y
    case "${yn}" in
    [Yy]*)
      echo

      # ln -T doesn't exist on macOS. Be careful — only delete symlinks.
      [ -L "${HOME}/.config/nvim" ] && rm "${HOME}/.config/nvim"

      for link in "${symlinks[@]}"; do
        eval "${link}"
      done

      if [[ "${OS_IN_WSL}" = "1" && ${#symlinks_wsl[@]} -gt 0 ]]; then
        for link in "${symlinks_wsl[@]}"; do
          eval "${link//%WindowsUser/${windows_user}}"
        done
      fi

      break
      ;;
    [Nn]*) break ;;
    *) echo "Please answer y or n" ;;
    esac
  done
}

configure_system_configs() {
  _info "CONFIGURE SYSTEM CONFIGS"

  echo "Everything that required updating was updated"
}

configure_home_configs() {
  _info "CONFIGURE HOME CONFIGS"

  _ensure_local_file \
    "${DOTFILES_PATH}/.config/ghostty/config.local" \
    "${HOME}/.config/ghostty/config.local" \
    "# Add your custom overrides here, such as fonts, etc..
"

  # This phase runs after create_symlinks, so link the file we may have just
  # created rather than making the user re-run.
  _stowit -d "${DOTFILES_PATH}/.config" -t "${HOME}/.config/ghostty" ghostty

  echo "Everything that required updating was updated"
}

configure_shell() {
  _info "CONFIGURE SHELL (ZSH)"

  local local_files=(".zshrc.local" ".zprofile.local" ".aliases.local")
  local original_dotfiles_path="${DOTFILES_PATH}"

  for file in "${local_files[@]}"; do
    _ensure_local_file \
      "${DOTFILES_PATH}/.config/zsh/${file}" \
      "${HOME}/.config/zsh/${file}" \
      "# shellcheck shell=bash

# Any settings defined here are gitignored.
"
  done

  local zprofile_path="${DOTFILES_PATH}/.config/zsh/.zprofile.local"
  local aliases_path="${DOTFILES_PATH}/.config/zsh/.aliases.local"

  if ! grep -q "^export DOTFILES_PATH=.*$" "${zprofile_path}" 2>/dev/null; then
    printf '\nexport DOTFILES_PATH="%s"\n' "${DOTFILES_PATH}" >>"${zprofile_path}"
  fi

  if [ "${OS_TYPE}" == "darwin" ]; then
    if ! grep -q "HOMEBREW_NO_ANALYTICS" "${zprofile_path}" 2>/dev/null; then
      printf '\nexport HOMEBREW_NO_ANALYTICS=1\n' >>"${zprofile_path}"
    fi

    if ! grep -q "alias.*rm" "${zprofile_path}" 2>/dev/null; then
      printf "\n# safety net\nalias rm='rm -I'\n" >>"${zprofile_path}"
    fi

    if ! grep -q "eval.*brew.*shellenv" "${zprofile_path}" 2>/dev/null; then
      local prefix="/opt/homebrew"
      [[ "${CPU_ARCH}" == "x86_64" ]] && prefix="/usr/local"

      printf "\neval \"\$(%s/bin/brew shellenv)\"\n" "${prefix}" >>"${zprofile_path}"
    fi

    if ! grep -q '^alias ls="ls -G"' "${aliases_path}" 2>/dev/null; then
      cat <<EOF >>"${aliases_path}"

alias ls="ls -G"
alias grep="grep -G"
alias fgrep="fgrep -G"
alias egrep="egrep -G"
EOF
    fi
  else
    if [ "${OS_IN_WSL}" = "1" ]; then
      # Auto-start dockerd on WSL 2 if Docker is installed without Docker
      # Desktop and we're not running systemd.
      if command -v docker >/dev/null 2>&1; then
        if [ ! -d "${HOME}/.docker/desktop" ]; then
          if [ ! -d /run/systemd/system ]; then
            if ! grep -q "^if service docker status.*$" "${zprofile_path}" 2>/dev/null; then
              local docker=
              docker=$(
                cat <<'EOF'
# Ensure Docker is running on WSL 2. This expects you've installed Docker and
# Docker Compose directly within your WSL distro instead of Docker Desktop.
if service docker status 2>&1 | grep -q "is not running"; then
  wsl.exe --distribution "${WSL_DISTRO_NAME}" --user root \
    --exec /usr/sbin/service docker start >/dev/null 2>&1
fi
EOF
              )

              printf "\n\n%s" "${docker}" >>"${zprofile_path}"
            fi
          fi
        fi
      fi

      if ! grep -q '^alias drop_cache=' "${aliases_path}" 2>/dev/null; then
        cat <<EOF >>"${aliases_path}"

# This is specific to WSL 2. If the WSL 2 VM goes rogue and decides not to free
# up memory, this command will free your memory after about 20-30 seconds.
#   Details: https://github.com/microsoft/WSL/issues/4166#issuecomment-628493643
alias drop_cache="sudo sh -c \"echo 3 >'/proc/sys/vm/drop_caches' && swapoff -a && swapon -a && printf '\n%s\n' 'Ram-cache and Swap Cleared'\""
EOF
      fi

      if ! grep -q '^alias open="/mnt/c/Program' "${aliases_path}" 2>/dev/null; then
        cat <<EOF >>"${aliases_path}"

alias open="/mnt/c/Program\ Files/Mozilla\ Firefox/firefox.exe"
alias wopen="cmd.exe /C start 2> /dev/null"
EOF
      fi
    fi

    if ! grep -q "alias.*rm" "${zprofile_path}" 2>/dev/null; then
      printf "\n# safety net\nalias rm='rm -I --preserve-root'\n" >>"${zprofile_path}"
    fi

    if ! grep -q 'alias ls="ls --color=auto"' "${aliases_path}" 2>/dev/null; then
      cat <<EOF >>"${aliases_path}"

alias ls="ls --color=auto"
alias grep="grep --color=auto"
alias fgrep="fgrep --color=auto"
alias egrep="egrep --color=auto"
EOF
    fi
  fi

  local shell_path=
  shell_path="$(which zsh)"

  if ! grep -q "${shell_path}" /etc/shells; then
    echo "${shell_path}" | sudo tee -a /etc/shells 1>/dev/null
  fi

  # Symlink the newly created local files.
  stow -R -d "${DOTFILES_PATH}/.config" -t "${HOME}/.config/zsh" --ignore='(?<!\.local)$' zsh 2>/dev/null || true

  [ "${SHELL: -3}" != "zsh" ] && chsh -s "${shell_path}"

  # shellcheck disable=SC1091
  source "${HOME}/.config/zsh/.zprofile"

  # The above re-source can clobber DOTFILES_PATH (e.g., in containers where
  # .local files are volume-mounted with a different path). Restore it.
  DOTFILES_PATH="${original_dotfiles_path}"

  echo "It has been configured in '${HOME}/.config/zsh/'"
}

ask_for_name() {
  _info "ASKING FOR YOUR NAME TO CONFIGURE GIT"

  local name=

  set +o errexit
  name="$(git config user.name)"
  set -o errexit

  if [ -n "${name}" ]; then
    _skipping "'${name}' was retrieved from your git config"
  else
    if [ -n "${YOUR_NAME}" ]; then
      _skipping "'${YOUR_NAME}' was retrieved from your install config"
      return 0
    fi

    while true; do
      printf "What is your full name (ie. Bruce Wayne)? "
      read -r name

      if [[ ${name} =~ [^[:space:]]+ ]]; then
        break
      else
        printf "Please enter at least your first name\n\n"
      fi
    done
  fi

  YOUR_NAME="${name}"
}

ask_for_email() {
  _info "ASKING FOR YOUR EMAIL TO CONFIGURE GIT"

  local email=

  set +o errexit
  email="$(git config user.email)"
  set -o errexit

  if [ -n "${email}" ]; then
    _skipping "'${email}' was retrieved from your git config"
  else
    if [ -n "${YOUR_EMAIL}" ]; then
      _skipping "'${YOUR_EMAIL}' was retrieved from your install config"
      return 0
    fi

    while true; do
      printf "What is your email address (ie. bruce@waynecorp.com)? "
      read -r email

      if [[ ${email} =~ .+@.+ ]]; then
        break
      else
        printf "Please enter a valid email address\n\n"
      fi
    done
  fi

  YOUR_EMAIL="${email}"
}

create_ssh_key() {
  _info "CREATING SSH KEY"

  local -r key_path="${HOME}/.ssh/id_ed25519"

  if [ -f "${key_path}" ]; then
    _skipping "A key already exists at '${key_path}'"
  else
    ssh-keygen -t ed25519 -C "${YOUR_EMAIL}" -N "" -f "${key_path}"
  fi

  _info "SHOWING PUBLIC SSH KEY"

  cat "${key_path}.pub"
}

create_gpg_key() {
  _info "CREATING GPG KEY"

  local gpg_home="${GNUPGHOME:-"${XDG_CONFIG_HOME}/gnupg"}"
  local gpg_key=

  set +o errexit
  gpg_key="$(gpg --export --armor "${YOUR_EMAIL}" 2>/dev/null)"
  set -o errexit

  if [[ "${gpg_key}" =~ "PGP PUBLIC KEY" ]]; then
    _skipping "A key already exists for '${YOUR_EMAIL}'"
  else
    mkdir -p "${gpg_home}"
    chmod 700 "${gpg_home}"

    while true; do
      printf "Please set a passphrase (password) for your key: "
      read -sr passphrase

      if [[ ! ${passphrase} =~ [^[:space:]]+ ]]; then
        printf "\nPlease enter at least 1 non-space character\n\n"
        continue
      fi

      printf "\n\nPlease confirm your passphrase: "
      read -sr passphrase_confirm

      [ "${passphrase}" = "${passphrase_confirm}" ] && break

      printf "\nYour passphrase did not match, please try again\n\n"
    done

    printf "\n\nGenerating GPG key...\n\n"

    gpg --batch --gen-key <<EOF
     Key-Type: 1
     Key-Length: 3072
     Subkey-Type: 1
     Subkey-Length: 3072
     Name-Real: ${YOUR_NAME}
     Name-Email: ${YOUR_EMAIL}
     Passphrase: ${passphrase}
     Expire-Date: 1y
EOF

    gpg_key="$(gpg --export --armor "${YOUR_EMAIL}" 2>/dev/null)"
  fi

  _info "SHOWING PUBLIC GPG KEY"

  echo "${gpg_key}" | gpg --show-keys
}

configure_git() {
  _info "CONFIGURE GIT"

  local git_config_local_path="${DOTFILES_PATH}/.config/git/config.local"

  if [ ! -f "${git_config_local_path}" ]; then
    cat <<EOF >"${git_config_local_path}"
[user]
  name = ${YOUR_NAME}
  email = ${YOUR_EMAIL}

[delta]
  # If you prefer side by side diffs, uncomment this.
  #side-by-side = true

[gpg]
  format = ssh
EOF

    # 1Password's SSH signing helper lives somewhere different on each platform.
    # WSL shells out to the Windows binary; native Linux gets the deb/AUR path.
    if [ "${OS_IN_WSL}" == "1" ]; then
      cat <<EOF >>"${git_config_local_path}"
[gpg "ssh"]
  program = "/mnt/c/Users/LVI/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"
EOF
    elif [ "${OS_TYPE}" == "linux" ]; then
      cat <<EOF >>"${git_config_local_path}"
[gpg "ssh"]
  program = "/opt/1Password/op-ssh-sign"
EOF
    else
      cat <<EOF >>"${git_config_local_path}"
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
EOF
    fi
  fi

  stow -R -d "${DOTFILES_PATH}/.config" -t "${HOME}/.config/git" --ignore="^(config|ignore)$" git 2>/dev/null || true

  echo "It has been configured in '$(dirname "${git_config_local_path}")'"
}

install_programming_languages() {
  _info "INSTALL PROGRAMMING LANGUAGES"

  for lang in "${!MISE_LANGUAGES[@]}"; do
    [[ "${lang}" = "0" || -z "${MISE_LANGUAGES[${lang}]}" ]] && continue

    printf "\nInstalling %s...\n\n" "${MISE_LANGUAGES[${lang}]}"
    if command -v "${HOME}/.local/share/mise/shims/${lang}" 1>/dev/null; then
      _skipping "${lang} is already installed (run 'mise upgrade ${lang} --bump' to upgrade)"
    else
      mise use --global "${MISE_LANGUAGES[${lang}]}"
    fi
  done

  for lang in "${!MISE_LANGUAGES_EXTRAS[@]}"; do
    [ -z "${MISE_LANGUAGES_EXTRAS[${lang}]}" ] && continue

    printf "\nInstalling %s...\n\n" "${MISE_LANGUAGES_EXTRAS[${lang}]}"
    if command -v "${HOME}/.local/share/mise/shims/${lang}" 1>/dev/null; then
      _skipping "${lang} is already installed (run 'mise upgrade ${lang} --bump' to upgrade)"
    else
      mise use --global "${MISE_LANGUAGES_EXTRAS[${lang}]}"
    fi
  done
}

install_tmux_plugins() {
  _info "INSTALL TMUX PLUGINS"

  export TMUX_PLUGIN_MANAGER_PATH="${HOME}/.config/tmux/plugins"
  local tpm_path="${TMUX_PLUGIN_MANAGER_PATH}/tpm"

  rm -rf "${tpm_path}"
  git clone --depth 1 https://github.com/tmux-plugins/tpm "${tpm_path}"

  # Not a TPM @plugin — the theme files reference it by path — so it's cloned
  # here. Pull on re-runs instead of failing on an existing directory.
  local catppuccin_path="${TMUX_PLUGIN_MANAGER_PATH}/catppuccin/tmux"

  mkdir -p "${TMUX_PLUGIN_MANAGER_PATH}/catppuccin"

  if [ -d "${catppuccin_path}/.git" ]; then
    echo "Updating catppuccin/tmux..."
    git -C "${catppuccin_path}" pull --ff-only
  else
    rm -rf "${catppuccin_path}"
    git clone https://github.com/catppuccin/tmux.git "${catppuccin_path}"
    git -C "${catppuccin_path}" config remote.origin.tagOpt --tags
    git -C "${catppuccin_path}" config fetch.pruneTags true
  fi

  "${tpm_path}/bin/install_plugins"
}

install_nvim_plugins() {
  _info "INSTALL NEOVIM PLUGINS"

  nvim --headless '+Lazy install' +qall 1>/dev/null || true

  echo "They've been installed"
}

set_theme() {
  local theme="tokyonight-moon"

  local active_theme=
  local theme_changed=

  _info "SETTING THEME"

  # Pull the active theme out of the fzf symlink path. Empty on first run is fine.
  if [ -f "${HOME}/.config/fzf/theme.sh" ]; then
    active_theme="$(readlink "${HOME}/.config/fzf/theme.sh")"
    active_theme="$(dirname "${active_theme}")"
    active_theme="$(basename "${active_theme##*/}")"
  fi

  # Run from install: keep current theme. Run via dot-theme-set: $1 is set.
  if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    [ -n "${active_theme}" ] && theme="${active_theme}"
  else
    theme="${1}"
  fi

  if [ ! -d "${DOTFILES_PATH}/themes/${theme}" ]; then
    if [ -d "${DOTFILES_PATH}/_themes/${theme}" ]; then
      cat <<EOF >&2

Theme '${theme}' hasn't been fetched yet. Its colours are licensed, so they
aren't committed to this repo -- render them from the templates with:

    dot-theme-fetch ${theme}

EOF
    else
      echo "Theme '${theme}' not found, aborting!" >&2
    fi

    return 1
  fi

  [[ -n "${active_theme}" && "${active_theme}" != "${theme}" ]] && theme_changed=1

  [ -z "${OS_DISTRO:-}" ] && detect_env

  ln -fns "${DOTFILES_PATH}/themes/${theme}/alacritty.toml" "${HOME}/.config/alacritty/theme.toml"
  ln -fns "${DOTFILES_PATH}/themes/${theme}/btop.theme" "${HOME}/.config/btop/themes/theme.theme"
  ln -fns "${DOTFILES_PATH}/themes/${theme}/fzf.sh" "${HOME}/.config/fzf/theme.sh"
  ln -fns "${DOTFILES_PATH}/themes/${theme}/ghostty" "${HOME}/.config/ghostty/theme"
  ln -fns "${DOTFILES_PATH}/themes/${theme}/gitui.ron" "${HOME}/.config/gitui/theme.ron"
  ln -fns "${DOTFILES_PATH}/themes/${theme}/nvim.lua" "${HOME}/.config/nvim/lua/plugins/theme.lua"
  ln -fns "${DOTFILES_PATH}/themes/${theme}/tmux.conf" "${HOME}/.config/tmux/theme.conf"

  # bottom is the one exception to the symlink model: it has no config import
  # mechanism, so shared settings and per-theme styles are concatenated into a
  # generated file. The two halves declare disjoint tables, so this is valid
  # TOML.
  cat "${DOTFILES_PATH}/.config/bottom/base.toml" \
    "${DOTFILES_PATH}/themes/${theme}/bottom-styles.toml" \
    >"${HOME}/.config/bottom/bottom.toml"

  echo "'${theme}' is your active theme"

  [ -z "${theme_changed}" ] && return

  if [ "${OS_IN_WSL}" = "1" ]; then
    local windows_user=
    windows_user="$(powershell.exe '$env:UserName' | tr -d '\r\n')"

    WT_PATH="/mnt/c/Users/${windows_user}/AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json"
    SED_EXPR='s/\("\(colorScheme\|theme\)": *"\)[^"]*"/\1'"${theme}"'"/'

    [ -e "${WT_PATH}" ] && sed -i "${SED_EXPR}" "${WT_PATH}"
  else
    pkill -USR2 -x ghostty 2>/dev/null || true
  fi

  pkill -USR2 -x btop 2>/dev/null || true
  tmux source-file "${HOME}/.config/tmux/tmux.conf" 2>/dev/null || true

  # alacritty repaints on its own via live_config_reload. bottom has no reload
  # mechanism at all, so say so rather than silently doing nothing.
  if pgrep -x btm >/dev/null 2>&1; then
    echo "Restart 'btm' to pick up the new theme"
  fi
}

healthcheck() {
  _info "CHECK INFORMATION AND VERSIONS"

  cat <<EOF
:: Dotfiles path:

${DOTFILES_PATH}

:: Git user:

$(git config --get-regex "user.(name|email)")

:: tmux:

$(tmux -V)

:: Neovim:

$(nvim --version)

:: Fastfetch:

EOF

  fastfetch
}

completed_message() {
  _info "NEXT STEPS (MAKE IT YOUR OWN)"

  cat <<EOF
Check out the README file on GitHub for any next steps:

https://github.com/${DOTFILES_REPO_SLUG}#-make-it-your-own

You can safely close this terminal.

The next time you open your terminal everything will be ready to go!
EOF

  if [[ -f "/tmp/CascadiaCode.zip" && "${OS_IN_WSL}" = "1" ]]; then
    cat <<EOF

P.S.,

Since you're on WSL 2, please scroll up to the "INSTALL FONTS" section and
follow the few steps there to complete the installation. You only need to do
this once to install a few system fonts.
EOF
  fi
}

# -----------------------------------------------------------------------------
# CLI
# -----------------------------------------------------------------------------

parse_args() {
  case "${1:-}" in
  --diff-config | -g)
    side_by_side="${2:-}"
    [ "${side_by_side}" = "--side" ] && side_by_side="--side-by-side"

    delta install-config.example install-config ${side_by_side}

    exit
    ;;
  --diff | -d)
    target="${2:-origin}"
    side_by_side="${3:-}"

    if [ "${target}" = "--side" ]; then
      target="origin"
      side_by_side="--side"
    fi

    git remote | grep -q "${target//./}" && git fetch "${target//./}"

    "${DOTFILES_PATH}/.local/bin/gd" "${target}" ${side_by_side:+"${side_by_side}"}

    _info "CONDENSED GIT DIFF"
    GIT_PAGER="" git diff "${target}" --compact-summary

    exit
    ;;
  --new-commits | -n)
    target="${2:-..origin}"
    side_by_side="${3:-}"

    if [ "${target}" = "--side" ]; then
      target="..origin"
      side_by_side="--side"
    fi

    git remote | grep -q "${target//./}" && git fetch --quiet "${target//./}"
    "${DOTFILES_PATH}/.local/bin/gl" "${target}" ${side_by_side:+"${side_by_side}"}

    exit
    ;;
  --changelog | -c)
    target="${2:-origin}"
    side_by_side="${3:-}"

    if [ "${target}" = "--side" ]; then
      target="origin"
      side_by_side="--side"
    fi

    git remote | grep -q "${target}" && git fetch --quiet "${target}"
    "${DOTFILES_PATH}/.local/bin/gl" "${target}" ${side_by_side:+"${side_by_side}"}

    exit
    ;;
  --local-files | -l)
    {
      fd --type file --unrestricted --extension "local" .
      fd --type file --unrestricted ".local/bin/local"
      echo ".config/zsh/.zsh_history"
      echo "install-config"
    } | sort --unique | fzf --multi --preview='bat --color=always {}' --bind "ctrl-a:toggle-all"

    exit
    ;;
  --debug | -b)
    detect_env

    _info "DEBUG INFORMATION" ""

    cat <<EOF
${C_BLUE}#### Dotfiles Environment${C_RESET}

${C_WHITE}\`\`\`sh${C_RESET}
$(_dotfiles_env)
${C_WHITE}\`\`\`${C_RESET}
EOF

    local system_info=
    if system_info="$(fastfetch --logo none --structure-disabled "Title:Separator:Colors:Break" 2>/dev/null)"; then
      cat <<EOF

${C_BLUE}#### System Details${C_RESET}

${C_WHITE}\`\`\`yaml${C_RESET}
${system_info}
${C_WHITE}\`\`\`${C_RESET}
EOF
    fi

    cat <<EOF
${C_WHITE}
If something isn't working as expected, if it makes sense please include the
above when creating an issue at: ${DOTFILES_CLONE_URL}${C_RESET}
EOF

    exit
    ;;
  --pull | -p)
    PULL=1
    ;;
  --update | -u)
    PULL_UPDATE=1
    ;;
  --symlinks | -s)
    ONLY_SYMLINKS=1
    ;;
  --yes | -y)
    YYES=1
    ;;
  --skip-system-packages | -S)
    SKIP_SYSTEM_PACKAGES=1
    ;;
  --help | -h)
    cat <<EOF
${C_BLUE}-------------------------------------------------------------------------------
KEEPING UP TO DATE
-------------------------------------------------------------------------------${C_RESET}

${C_WHITE}# Run the install script based on the local copy of your dotfiles.
${C_GREEN}./install

${C_WHITE}# The same as above but skip installing packages (useful for updating symlinks).
${C_GREEN}./install --skip-system-packages | -S

${C_WHITE}# Re-stow symlinks only, then run the healthcheck.
${C_GREEN}./install --symlinks | -s

${C_WHITE}# Pull in the latest remote commits.
${C_GREEN}./install --pull | -p

${C_WHITE}# Pull in the latest remote commits and run the install script.
${C_GREEN}./install --update | -u

${C_BLUE}-------------------------------------------------------------------------------
WHAT'S DIFFERENT
-------------------------------------------------------------------------------${C_RESET}

${C_WHITE}# Diff your install-config vs the local install-config.example.
${C_GREEN}./install --diff-config | -g ${C_CYAN}[--side]

${C_WHITE}# Diff any local uncommited or committed changes vs the remote (defaults to "origin").
${C_GREEN}./install --diff | -d ${C_CYAN}[TARGET] [--side]

${C_WHITE}# Show new remote commits that do not exist locally.
${C_GREEN}./install --new-commits | -n ${C_CYAN}[TARGET] [--side]${C_WHITE}    (defaults to "..origin")

${C_WHITE}# Show a list of commits on a remote.
${C_GREEN}./install --changelog | -c ${C_CYAN}[TARGET] [--side]${C_WHITE}    (defaults to "origin")

${C_WHITE}# Browse all gitignored configs, history, and local-only scripts.
${C_GREEN}./install --local-files | -l

${C_BLUE}-------------------------------------------------------------------------------
DIAGNOSTICS
-------------------------------------------------------------------------------${C_RESET}

${C_WHITE}# Print environment + system info, useful for issues.
${C_GREEN}./install --debug | -b

${C_WHITE}# Show this help menu.
${C_GREEN}./install --help | -h${C_RESET}
EOF
    exit
    ;;
  *)
    [ -n "${1:-}" ] && _error "'${1}' is not a supported flag"
    ;;
  esac

  return 0
}

# -----------------------------------------------------------------------------
# Main flow (only when executed, not sourced)
# -----------------------------------------------------------------------------

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # User customization first — its values override the defaults below.
  [ -f "${DOTFILES_PATH}/install-config" ] && source "${DOTFILES_PATH}/install-config"

  # Re-apply URL defaults in case install-config set them to empty strings.
  _apply_dotfiles_defaults

  LOCAL="${LOCAL:-}"
  YYES="${YES:-}"
  PULL=
  PULL_UPDATE=
  ONLY_SYMLINKS=
  SKIP_SYSTEM_PACKAGES=

  YOUR_NAME="${YOUR_NAME:-}"
  YOUR_EMAIL="${YOUR_EMAIL:-}"

  detect_env

  case "${OS_DISTRO}" in
  debian)
    # shellcheck disable=SC1091
    source "${DOTFILES_PATH}/_install/packages/debian"
    ;;
  arch)
    # shellcheck disable=SC1091
    source "${DOTFILES_PATH}/_install/packages/arch"
    ;;
  darwin)
    # shellcheck disable=SC1091
    source "${DOTFILES_PATH}/_install/packages/darwin"
    ;;
  *)
    [ -z "${SKIP_SYSTEM_PACKAGES}" ] && _no_system_packages
    ;;
  esac

  # shellcheck disable=SC1091
  source "${DOTFILES_PATH}/_install/mise_languages"
  # shellcheck disable=SC1091
  source "${DOTFILES_PATH}/_install/symlinks"

  parse_args "${@}"
  warn_root
  update_dotfiles "${@}"

  [ -n "${PULL}" ] && exit

  check_prereqs
  create_initial_dirs

  if [ -n "${ONLY_SYMLINKS}" ]; then
    create_symlinks
    healthcheck
    exit
  fi

  install_packages
  clone_dotfiles
  install_fonts
  install_omz
  install_omz_plugins
  create_symlinks
  configure_system_configs
  configure_home_configs
  configure_shell
  ask_for_name
  ask_for_email
  create_ssh_key
  create_gpg_key
  configure_git
  install_programming_languages
  install_tmux_plugins
  install_nvim_plugins
  set_theme
  healthcheck
  completed_message
fi
